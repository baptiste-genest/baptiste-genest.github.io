{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
    {{- end }}
  </url>
  {{- end }}
  {{- /* Papers live in static/, so Hugo does not know about them as Pages.
         Enumerate the PDFs directly so they can be tracked in Search Console. */}}
  {{- range (readDir "static/papers") }}
  {{- if strings.HasSuffix .Name ".pdf" }}
  <url>
    <loc>{{ printf "papers/%s" .Name | absURL }}</loc>
    <lastmod>{{ safeHTML ( .ModTime.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
  </url>
  {{- end }}
  {{- end }}
</urlset>
